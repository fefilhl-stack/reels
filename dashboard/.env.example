# Адрес, по которому открыт дашборд. Из него строятся redirect URI для OAuth:
#   ${APP_URL}/api/oauth/tiktok/callback
#   ${APP_URL}/api/oauth/instagram/callback
#   ${APP_URL}/api/oauth/youtube/callback
APP_URL=http://localhost:3100

# Пароль для входа. Пусто = без пароля (только для запуска на своём компьютере).
DASHBOARD_PASSWORD=

# Секрет для подписи сессии и шифрования токенов площадок (любая длинная случайная строка).
# Если пусто, создаётся автоматически в data/.secret.
APP_SECRET=

# Часовой пояс для расписания, календаря и «лучшего времени публикации».
APP_TIMEZONE=Europe/Moscow

# Где хранить базу и загруженные ролики.
DATA_DIR=./data

# Фоновый планировщик (публикации по расписанию, сбор статистики). false — отключить.
WORKER_ENABLED=true
# Секрет для внешнего крона: GET /api/cron?secret=...
CRON_SECRET=

# TikTok for Developers: Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta: Instagram API with Instagram Login (бизнес- или авторский аккаунт)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=v26.0
# resumable — загружать файл в Instagram напрямую вместо скачивания по ссылке (нужен, если APP_URL не публичный)
INSTAGRAM_UPLOAD=

# Google Cloud: YouTube Data API v3 + YouTube Analytics API, OAuth client «Web application»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Необязательно: ИИ-помощник (подписи, хуки, идеи) на Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
